map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

upstream control_api_upstream {
  server control-api:4010;
}

upstream session_client_upstream {
  server session-client:4173;
}

map $browser_worker_id $browser_upstream {
  default "";
  dad worker-dad:6080;
  wife worker-wife:6080;
  shared-1 worker-shared-1:6080;
}

map $query_string $browser_session_id_query {
  default "";
  ~*(^|&)sessionId=([^&]+) $2;
}

map $query_string $browser_access_token_query {
  default "";
  ~*(^|&)accessToken=([^&]+) $2;
}

map $http_cookie $browser_session_id_cookie {
  default "";
  "~*(?:^|;\\s*)browserSessionId=([^;]+)" $1;
}

map $http_cookie $browser_access_token_cookie {
  default "";
  "~*(?:^|;\\s*)browserAccessToken=([^;]+)" $1;
}

map $browser_session_id_query $browser_session_id {
  default $browser_session_id_query;
  "" $browser_session_id_cookie;
}

map $browser_access_token_query $browser_access_token {
  default $browser_access_token_query;
  "" $browser_access_token_cookie;
}

server {
  listen 8080;
  server_name _;

  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  location = /healthz {
    return 404;
  }

  location = /readyz {
    return 404;
  }

  location /internal/ {
    return 404;
  }

  location ^~ /internal/browser/ {
    return 404;
  }

  location = /health {
    return 404;
  }

  location = /internal/relay/messages {
    return 404;
  }

  location = /internal/worker {
    return 404;
  }

  location ^~ /api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://control_api_upstream;
  }

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://session_client_upstream;
  }
}

server {
  listen 8081;
  server_name _;

  resolver 127.0.0.11 ipv6=off;

  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  location = /healthz {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-internal-admin-token "${INTERNAL_ADMIN_TOKEN}";
    proxy_pass http://control_api_upstream;
  }

  location = /readyz {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-internal-admin-token "${INTERNAL_ADMIN_TOKEN}";
    proxy_pass http://control_api_upstream;
  }

  location = /internal/admin {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-internal-admin-token "${INTERNAL_ADMIN_TOKEN}";
    proxy_pass http://control_api_upstream;
  }

  location = /internal/browser-access/authorize {
    internal;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-internal-admin-token "${INTERNAL_ADMIN_TOKEN}";
    proxy_pass http://control_api_upstream/internal/browser-access/authorize?workerId=$auth_worker_id&sessionId=$auth_session_id&accessToken=$auth_access_token;
  }

  location ~ ^/internal/browser/(?<browser_worker_id>(dad|wife|shared-1))/(?<browser_path>.+)$ {
    set $auth_worker_id $browser_worker_id;
    set $auth_session_id $browser_session_id;
    set $auth_access_token $browser_access_token;
    auth_request /internal/browser-access/authorize;
    add_header Set-Cookie "browserSessionId=$browser_session_id; Max-Age=900; Path=/internal/browser/$browser_worker_id/; HttpOnly; SameSite=Strict" always;
    add_header Set-Cookie "browserAccessToken=$browser_access_token; Max-Age=900; Path=/internal/browser/$browser_worker_id/; HttpOnly; SameSite=Strict" always;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Browser-Worker-Id $browser_worker_id;
    proxy_set_header X-Browser-Session-Id $browser_session_id;
    proxy_set_header X-Browser-Access-Token $browser_access_token;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://$browser_upstream/$browser_path$is_args$args;
  }

  location /internal/ {
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-internal-admin-token "${INTERNAL_ADMIN_TOKEN}";
    proxy_pass http://control_api_upstream;
  }

  location / {
    return 404;
  }
}
